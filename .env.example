# Copy to .env and fill in. Never commit .env (see .gitignore).
#
# The dashboard reads exactly one env var. For Azure, set the same key
# under "Settings → Environment variables" on the App Service.

# Local docker-compose default:
CAREVAULT_DASHBOARD_PG=host=127.0.0.1 port=5433 dbname=carevault user=dashboard_ro password=dashboard

# Azure Flexible Server example (don't commit the real password):
# CAREVAULT_DASHBOARD_PG=host=carevault.postgres.database.azure.com port=5432 dbname=carevault user=dashboard_ro password=REPLACE_ME sslmode=require
